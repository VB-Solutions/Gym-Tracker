# Copiar este archivo a .env y completar los valores (.env no se commitea).

# Obligatorio. Generar uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# True solo en desarrollo
DJANGO_DEBUG=True

# Listas separadas por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ORIGINS=http://localhost:5173

# Base de datos. Sin DATABASE_URL se usa db.sqlite3 (desarrollo)
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# Nivel de log (DEBUG, INFO, WARNING...)
# DJANGO_LOG_LEVEL=INFO

# --- Solo producción (con DJANGO_DEBUG=False) ---
# Orígenes HTTPS del admin, ej. https://api.midominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=
# True si un proxy termina el HTTPS y manda X-Forwarded-Proto
# DJANGO_BEHIND_PROXY=False
# Redirigir HTTP a HTTPS (por defecto True)
# DJANGO_SSL_REDIRECT=True
# Duración de HSTS en segundos (por defecto 30 días)
# DJANGO_HSTS_SECONDS=2592000
# Procesos de gunicorn en el contenedor (por defecto 3)
# WEB_CONCURRENCY=3
